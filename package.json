{
  "name": "magic-patterns-vite-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "build": "npx vite build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "preview": "npx vite preview",
    "demo": "vite build -c demo/vite.demo.config.ts",
    "test:pose": "esbuild scripts/pose-test.ts --bundle --platform=node --format=cjs --outfile=.tmp/pose-test.cjs --log-level=error && node .tmp/pose-test.cjs",
    "test:plan": "esbuild scripts/plan-check.ts --bundle --platform=node --format=cjs --outfile=.tmp/plan-check.cjs --log-level=error --loader:.png=dataurl && node .tmp/plan-check.cjs",
    "test:rest": "npx esbuild scripts/rest-check.ts --bundle --platform=node --format=cjs --outfile=.tmp/rest-check.cjs --log-level=error && node .tmp/rest-check.cjs"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.5.4",
    "lucide-react": "0.522.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "latest",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "postcss": "latest",
    "tailwindcss": "3.4.17",
    "typescript": "^5.5.4",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}

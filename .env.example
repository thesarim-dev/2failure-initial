VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# From Supabase Dashboard → Project Settings → API (Publishable key or anon public JWT)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Production site URL (Vercel). Leave unset for local dev — uses window.location.origin.
# VITE_SITE_URL=https://2failure-initial.vercel.app

# Supabase Auth → Providers: enable Google.
# Supabase Auth → URL Configuration:
#   Site URL: https://2failure-initial.vercel.app
#   Redirect URLs:
#     http://localhost:5173
#     https://2failure-initial.vercel.app
#     https://*.vercel.app/**   (optional, for preview deploys)

# Pushup workouts: camera + AI rep tracking (set to false to use timer-only mode)
VITE_ENABLE_PUSHUP_AI=true
